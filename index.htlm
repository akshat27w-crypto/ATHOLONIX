<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ATHLONIX | Sports Performance Lab</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Orbitron:wght@500;700;800;900&display=swap');

:root {
  --bg: #05070c;
  --panel: #0c1422;
  --line: #24364c;
  --cyan: #37e6ff;
  --violet: #a66bff;
  --red: #ff365e;
  --white: #f4f7ff;
  --muted: #94a7bf;
  --green: #69ffb4;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--white);
  font-family: Inter, Arial, sans-serif;
  background-image:
    radial-gradient(ellipse at 10% 0%, #37e6ff17, transparent 38%),
    radial-gradient(ellipse at 90% 15%, #a66bff18, transparent 34%),
    linear-gradient(#37e6ff08 1px, transparent 1px),
    linear-gradient(90deg, #37e6ff08 1px, transparent 1px);
  background-size: auto, auto, 38px 38px, 38px 38px;
}

button, input, select, textarea {
  font: inherit;
}

button, a {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

header {
  height: 72px;
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 5%;
  background: #05070cef;
  border-bottom: 1px solid #37e6ff44;
  backdrop-filter: blur(14px);
}

.brand {
  font: 900 20px Orbitron, sans-serif;
  letter-spacing: 2px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand b {
  color: var(--cyan);
}

.logo {
  border: 2px solid var(--cyan);
  color: var(--cyan);
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  box-shadow: 0 0 20px #37e6ff40;
}

.status {
  font: 700 10px Orbitron, sans-serif;
  color: var(--green);
  letter-spacing: 1px;
  border: 1px solid #69ffb455;
  padding: 10px;
}

.menu {
  display: none;
  background: #111c2c;
  color: white;
  border: 1px solid var(--line);
  font-size: 20px;
  padding: 8px 12px;
}

.shell {
  display: flex;
  min-height: calc(100vh - 72px);
}

aside {
  width: 235px;
  flex-shrink: 0;
  background: #070b13ef;
  border-right: 1px solid var(--line);
  padding: 22px 13px;
  position: sticky;
  top: 72px;
  height: calc(100vh - 72px);
}

.navtitle {
  font: 700 9px Orbitron, sans-serif;
  letter-spacing: 2px;
  color: #71849f;
  padding: 15px 12px 8px;
}

.nav {
  display: block;
  color: #aabbd0;
  padding: 13px 12px;
  border: 1px solid transparent;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 700;
  margin: 4px 0;
}

.nav:hover,
.nav.active {
  color: white;
  border-color: #37e6ff50;
  background: linear-gradient(90deg, #37e6ff17, transparent);
  box-shadow: inset 3px 0 var(--cyan);
}

.asidebox {
  border: 1px solid var(--line);
  background: linear-gradient(140deg, #111e30, #090d16);
  padding: 14px;
  margin-top: 30px;
  border-radius: 5px;
  font-size: 11px;
  color: var(--muted);
  line-height: 1.7;
}

main {
  max-width: 1500px;
  width: 100%;
  padding: 30px clamp(16px, 4vw, 52px) 60px;
  margin: auto;
  min-width: 0;
}

.eyebrow {
  font: 700 10px Orbitron, sans-serif;
  color: var(--cyan);
  letter-spacing: 2px;
  text-transform: uppercase;
}

.eyebrow:before {
  content: "";
  display: inline-block;
  width: 22px;
  height: 2px;
  background: var(--cyan);
  vertical-align: middle;
  margin-right: 8px;
  box-shadow: 0 0 10px var(--cyan);
}

.hero {
  min-height: 370px;
  padding: clamp(24px, 5vw, 58px);
  border: 1px solid #2c4963;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(90deg, #050911 0%, #07101bef 52%, #080e1a77 100%),
    url('https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=1600&q=85')
    center/cover;
}